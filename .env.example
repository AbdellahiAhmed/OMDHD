# SMTP credentials for the contact/volunteer forms (lib/mail.ts).
# Set these as real values in the cPanel Node.js App's "Environment Variables"
# panel — never commit actual credentials to this file or the repo.

SMTP_HOST=mail.omdhd.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@omdhd.com
SMTP_PASS=

# Optional overrides — default to SMTP_USER / siteConfig.email if unset.
SMTP_FROM=
MAIL_TO=
